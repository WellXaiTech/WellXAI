<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. The app itself is always light (white
         background, black text) regardless of the device's system theme, so
         this is pinned light rather than left as the DayNight default —
         otherwise the native window background behind/around the content
         (visible as a flash on launch, and behind the status bar before the
         page paints) is dark, not the app's actual white.

         Theme.MaterialComponents (not plain Theme.AppCompat) is required
         here: MaterialDatePicker/MaterialTimePicker (used for the New
         task sheet's date/time pickers) throw at runtime otherwise
         ("...requires Theme.MaterialComponents (or descendant)"). It's a
         drop-in superset of AppCompat, so this doesn't change anything
         else about how the app looks. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/colorPrimary</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:navigationBarColor">@color/colorPrimaryDark</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>