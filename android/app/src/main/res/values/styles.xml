<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. The app itself is always light (white
         background, black text) regardless of the device's system theme, so
         this is pinned light rather than left as the DayNight default —
         otherwise the native window background behind/around the content
         (visible as a flash on launch, and behind the status bar before the
         page paints) is dark, not the app's actual white.

         Theme.MaterialComponents (not plain Theme.AppCompat) is required
         here: MaterialDatePicker/MaterialTimePicker (used for the New
         task sheet's date/time pickers) throw at runtime otherwise
         ("...requires Theme.MaterialComponents (or descendant)"). It's a
         drop-in superset of AppCompat, so this doesn't change anything
         else about how the app looks. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- android:windowBackground/statusBarColor/navigationBarColor
             below reference the colorPrimary *resource* (white, from
             colors.xml) directly, which is a separate thing from the
             colorPrimary *theme attr* set here, so rebinding the attr
             to colorAccent (black) for Material widget theming doesn't
             touch the window chrome at all.

             Material widgets (MaterialDatePicker/MaterialTimePicker's
             header band, selected-date circle, and OK/Cancel button text)
             read colorPrimary/colorSecondary for their own tinting, and
             default colorOnPrimary/colorOnSecondary to white when unset;
             left at this app's white colorPrimary, that made the header
             text and the buttons render as invisible white-on-white
             instead of just going unstyled. Binding colorPrimary to black
             gives a black header band with white text and black button
             text on the white dialog body, matching the rest of this
             monochrome app instead of leaving those pieces broken. -->
        <item name="colorPrimary">@color/colorAccent</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorOnPrimary">@color/colorPrimary</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorOnSecondary">@color/colorPrimary</item>
        <item name="colorSurface">@color/colorPrimary</item>
        <item name="colorOnSurface">@color/colorAccent</item>
        <item name="android:textColorPrimary">@color/colorAccent</item>
        <item name="android:windowBackground">@color/colorPrimary</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:navigationBarColor">@color/colorPrimaryDark</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>